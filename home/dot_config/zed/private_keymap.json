[
  {
    "context": "Workspace",
    "bindings": {
      "cmd-alt-1": "agent::FocusAgent",
      "cmd-alt-2": "workspace::FocusCenterPane"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "cmd-|": "editor::MoveToEnclosingBracket"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "cmd-|": "pane::SplitRight"
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "cmd-k right": "pane::SplitRight"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-| cmd-|": "pane::SplitRight"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "cmd-\\": "pane::SplitRight"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-m": "editor::MoveToEnclosingBracket"
    }
  }
]
