// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "icon_theme": "Catppuccin Mocha",
  "cli_default_open_behavior": "existing_window",
  "file_types": {
    "Python": ["modify_*.json.tmpl"],
    "Ruby": ["Brewfile", "*.Brewfile", "Brewfile.tmpl", "*.Brewfile.tmpl"],
    "Shell Script": ["*.sh.tmpl", "*.zsh.tmpl", "*.env.tmpl", "*.conf.tmpl"],
    "SSH Config": ["private_config.tmpl"],
    "TOML": ["*.toml.tmpl"],
    "XML": ["*.plist.tmpl", "*.xml.tmpl"],
    "YAML": ["*.yaml.tmpl", "*.yml.tmpl"]
  },
  "agent_servers": {
    "codex-acp": {
      "favorite_config_option_values": {
        "mode": ["agent"]
      },
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "agent": {
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.6-sol",
      "enable_thinking": true,
      "effort": "high"
    },
    "terminal_init_command": "",
    "play_sound_when_agent_done": "when_hidden",
    "notify_when_agent_waiting": "all_screens",
    "button": true,
    "dock": "left",
    "favorite_models": [
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.6-sol",
        "enable_thinking": true,
        "effort": "high"
      }
    ],
    "sandbox_permissions": {
      "network_hosts": [
        "zed.dev",
        "worktrunk.dev",
        "docs.anthropic.com",
        "code.claude.com",
        "raw.githubusercontent.com"
      ]
    },
    "tool_permissions": {
      "tools": {
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://zed\\.dev"
            }
          ]
        },
        "terminal": {
          "always_allow": [
            {
              "pattern": "^printf\\s+n---(\\s|$)"
            },
            {
              "pattern": "^ls\\b"
            }
          ]
        }
      }
    },
    "model_parameters": []
  },
  "git_panel": {
    "dock": "right"
  },
  "git": {
    "inline_blame": {
      "enabled": true
    }
  },
  "base_keymap": "VSCode",
  "auto_indent_on_paste": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Catppuccin Mocha"
  }
}
