# Homebrew's own environment file, read by `bin/brew` before any command runs.
# This is the right home for HOMEBREW_* settings rather than zshrc.d: it applies
# to unattended invocations too (chezmoi hooks, mother, launchd), which never
# source a shell rc.
#
# Load order, later wins:
#   1. /etc/homebrew/brew.env                    (system)
#   2. $HOMEBREW_PREFIX/etc/homebrew/brew.env    (prefix)
#   3. $HOMEBREW_USER_CONFIG_HOME/brew.env       (this file)
# Setting HOMEBREW_SYSTEM_ENV_TAKES_PRIORITY moves (1) last.
#
# HOMEBREW_USER_CONFIG_HOME resolves to $XDG_CONFIG_HOME/homebrew, else
# $HOMEBREW_XDG_CONFIG_HOME/homebrew, else ~/.homebrew. dot_zshenv sets
# XDG_CONFIG_HOME for every zsh; the bash scripts in scripts/apps/brew/ export
# HOMEBREW_XDG_CONFIG_HOME so this file is still found when a caller inherits
# neither.
#
# This is NOT shell. bin/brew reads each line, keeps only those matching
# ^(HOMEBREW_|SUDO_ASKPASS=|(all|no|ftp|https?)_proxy=), and `export`s the raw
# string. Consequences:
#   - No `export` keyword — such a line starts with "export" and gets dropped.
#   - No variable expansion; "$HOME/x" would be stored as that literal string.
#     Hence this file is a chezmoi .tmpl for the one path-valued setting.
#   - Non-matching lines are silently skipped, which is what makes these
#     comments safe.
#   - Cannot override HOMEBREW_BREW_FILE, HOMEBREW_PREFIX, HOMEBREW_REPOSITORY,
#     HOMEBREW_LIBRARY, HOMEBREW_USER_CONFIG_HOME, HOMEBREW_ORIGINAL_BREW_FILE.

# --- Noise and interruption --------------------------------------------------

# Auto-update runs before install, outdated, upgrade, bundle, release and
# `tap <arg>` (AUTO_UPDATE_COMMANDS in brew.sh); it is gated on the mtime of
# .git/FETCH_HEAD. brew's own default here is already 86400, so setting that
# value is a no-op — a week is the actual change. Freshness on demand stays
# `brew update`, by hand or via mother.
HOMEBREW_AUTO_UPDATE_SECS=604800

# Suppress the "==> New Formulae" / "==> New Casks" wall of text after an
# update. Pure noise: it lists packages you didn't ask for and can't act on.
HOMEBREW_NO_UPDATE_REPORT_NEW=1

# Don't check for broken linkage or outdated dependents after install, upgrade
# or reinstall. Keeps `brew install foo` from cascading into upgrades of
# unrelated packages, which is the biggest source of surprise work in a run.
# Trade-off: broken linkage is no longer auto-repaired. `brew doctor` still
# reports it; fix by hand on the rare occasion it happens.
HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1

# Note: HOMEBREW_NO_AUTO_UPDATE is deliberately NOT set here. Globally disabling
# it would also apply to bundle.sh, where a stale index means installing
# outdated versions. scripts/apps/brew/diff.sh sets it for itself instead.

# --- Quality of life ---------------------------------------------------------

# Don't send analytics.
HOMEBREW_NO_ANALYTICS=1

# Don't print hints about changing brew's behaviour via env vars. Worth knowing
# this is also why the "adjust with HOMEBREW_AUTO_UPDATE_SECS" hint, which would
# have flagged the no-op above, never appeared.
HOMEBREW_NO_ENV_HINTS=1

# Page `brew cat` through bat. Safe: bat is in .chezmoitemplates/brew/global.Brewfile.
HOMEBREW_BAT=1

# Print per-formula install times at the end of a run. Useful on a bundle run to
# see what's actually slow; a couple of extra lines otherwise.
HOMEBREW_DISPLAY_INSTALL_TIMES=1

# Let a bare interactive `brew bundle` resolve the managed Brewfile without
# --global. The scripts in scripts/apps/brew/ still pass --file explicitly and
# do not depend on this.
HOMEBREW_BUNDLE_FILE={{ .chezmoi.homeDir }}/.config/homebrew/Brewfile

# --- Commonly recommended, deliberately off ----------------------------------
# Kept here with the reasoning so the decision doesn't get relitigated.

# Strips Gatekeeper quarantine from every cask install. Very widely suggested,
# but it's a real security reduction for a small convenience: you lose
# first-launch verification on all GUI software installed via brew.
# HOMEBREW_CASK_OPTS=--no-quarantine

# Passes --greedy to all cask upgrades, forcing upgrades of casks that manage
# their own updates. Fights those apps' built-in updaters and re-downloads large
# bundles for no gain.
# HOMEBREW_UPGRADE_GREEDY=1

# Never auto-cleanup after install/upgrade/reinstall. Quieter runs, but the
# download cache then grows without bound. brew's defaults already cleanup
# per-formula and, every HOMEBREW_CLEANUP_PERIODIC_FULL_DAYS (30), everything;
# tune the age cutoff instead if this ever matters.
# HOMEBREW_NO_INSTALL_CLEANUP=1
# HOMEBREW_CLEANUP_MAX_AGE_DAYS=120

# Obsolete advice — brew's default is already `auto`, i.e. twice the number of
# available CPU cores.
# HOMEBREW_DOWNLOAD_CONCURRENCY=auto
