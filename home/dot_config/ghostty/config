# Ghostty Terminal Configuration
# https://ghostty.org/docs/config/reference


##### FONTS #####

font-family = FiraCode Nerd Font Mono
font-size = 17


##### WINDOW #####

background-opacity = 0.95
confirm-close-surface = false
working-directory = home
window-padding-x = 4
window-padding-y = 4


##### macOS SPECIFIC #####

macos-option-as-alt = left
macos-titlebar-style = tabs


##### SHELL INTEGRATION #####

# Automatic shell integration (zsh, bash, fish, elvish)
shell-integration = detect


##### KEY BINDINGS #####

# Tabs, splits, and pane navigation belong to herdr (home/dot_config/herdr/config.toml).
# Unbinding passes these chords through to herdr instead of making Ghostty tabs/splits.
keybind = cmd+t=unbind
keybind = cmd+w=unbind
keybind = cmd+alt+w=unbind
keybind = cmd+shift+[=unbind
keybind = cmd+shift+]=unbind
keybind = cmd+digit_1=unbind
keybind = cmd+digit_2=unbind
keybind = cmd+digit_3=unbind
keybind = cmd+digit_4=unbind
keybind = cmd+digit_5=unbind
keybind = cmd+digit_6=unbind
keybind = cmd+digit_7=unbind
keybind = cmd+digit_8=unbind
keybind = cmd+1=unbind
keybind = cmd+2=unbind
keybind = cmd+3=unbind
keybind = cmd+4=unbind
keybind = cmd+5=unbind
keybind = cmd+6=unbind
keybind = cmd+7=unbind
keybind = cmd+8=unbind
keybind = cmd+9=unbind
keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
keybind = cmd+[=unbind
keybind = cmd+]=unbind
keybind = cmd+shift+enter=unbind
keybind = cmd+alt+arrow_up=unbind
keybind = cmd+alt+arrow_down=unbind
keybind = cmd+alt+arrow_left=unbind
keybind = cmd+alt+arrow_right=unbind
keybind = cmd+ctrl+arrow_up=unbind
keybind = cmd+ctrl+arrow_down=unbind
keybind = cmd+ctrl+arrow_left=unbind
keybind = cmd+ctrl+arrow_right=unbind

# cmd+shift+; toggles the "ghostty" key table, restoring Ghostty's own tab/split
# keys for use outside herdr. Press it again to hand the keys back to herdr.
keybind = cmd+shift+semicolon=activate_key_table:ghostty
keybind = ghostty/cmd+shift+semicolon=deactivate_key_table
keybind = ghostty/cmd+t=new_tab
keybind = ghostty/cmd+w=close_surface
keybind = ghostty/cmd+alt+w=close_tab:this
keybind = ghostty/cmd+shift+[=previous_tab
keybind = ghostty/cmd+shift+]=next_tab
keybind = ghostty/cmd+1=goto_tab:1
keybind = ghostty/cmd+2=goto_tab:2
keybind = ghostty/cmd+3=goto_tab:3
keybind = ghostty/cmd+4=goto_tab:4
keybind = ghostty/cmd+5=goto_tab:5
keybind = ghostty/cmd+6=goto_tab:6
keybind = ghostty/cmd+7=goto_tab:7
keybind = ghostty/cmd+8=goto_tab:8
keybind = ghostty/cmd+9=last_tab
keybind = ghostty/cmd+d=new_split:right
keybind = ghostty/cmd+shift+d=new_split:down
keybind = ghostty/cmd+shift+backslash=new_split:right
keybind = ghostty/cmd+shift+minus=new_split:down
keybind = ghostty/cmd+[=goto_split:previous
keybind = ghostty/cmd+]=goto_split:next
keybind = ghostty/cmd+shift+enter=toggle_split_zoom
keybind = ghostty/cmd+alt+arrow_up=goto_split:up
keybind = ghostty/cmd+alt+arrow_down=goto_split:down
keybind = ghostty/cmd+alt+arrow_left=goto_split:left
keybind = ghostty/cmd+alt+arrow_right=goto_split:right
keybind = ghostty/cmd+ctrl+arrow_up=resize_split:up,10
keybind = ghostty/cmd+ctrl+arrow_down=resize_split:down,10
keybind = ghostty/cmd+ctrl+arrow_left=resize_split:left,10
keybind = ghostty/cmd+ctrl+arrow_right=resize_split:right,10


##### THEME #####

# Built-in theme (Ghostty includes many themes)
# Use `ghostty +list-themes` to see available themes
theme = Catppuccin Mocha
