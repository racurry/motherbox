{{- $profile := index . "profile" | default "personal" -}}
// Environment variables set for every Claude Code session.
{
  "env": {
{{- if eq $profile "personal" }}
    // Commit, push, and use gh as the agent GitHub account.
    "GIT_CONFIG_GLOBAL": "/Users/aaron/.config/git/config_agent",
    "GH_CONFIG_DIR": "/Users/aaron/.config/gh-agent",
{{- end }}
    // Keep Claude's temp files in one known place (also allowed in permissions.jsonc).
    "CLAUDE_CODE_TMPDIR": "/Users/aaron/.claude/tmp",
    // Model used by subagents unless an agent definition says otherwise.
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  }
}
