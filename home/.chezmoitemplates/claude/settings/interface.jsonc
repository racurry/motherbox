// Terminal look and feel.
{
  // Scripts live in home/dot_claude/statuslines/; point command at the one to use.
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statuslines/simple.py",
    "padding": 1
  },

  "spinnerTipsEnabled": true,
  "spinnerTipsOverride": {
    "tips": [
      "Stop wasting time",
      "🐊"
    ],
    // Show only my tips, never the built-in ones.
    "excludeDefault": true
  }
}
