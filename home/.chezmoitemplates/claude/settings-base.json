{
  "alwaysThinkingEnabled": true,
  "autoMemoryEnabled": false,
  "disableArtifact": true,
  "disableBundledSkills": true,
  "disableClaudeAiConnectors": false,
  "disableRemoteControl": false,
  "disableWorkflows": true,
  "syncClaudeAiSkills": false,
  "enableAllProjectMcpServers": true,
  "env": {
    "CLAUDE_CODE_TMPDIR": "/Users/aaron/.claude/tmp",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statuslines/statusline.py",
    "padding": 1
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Edit(//Users/aaron/.claude/tmp/**)"
    ],
    "deny": [
      "EnterPlanMode",
      "DesignSync",
      "NotebookEdit",
      "ScheduleWakeup",
      "CronCreate",
      "CronDelete",
      "CronList",
      "RemoteTrigger",
      "PushNotification",
      "ListAgents",
      "ReadNotifications"
    ],
    "ask": [
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "enableWeakerNetworkIsolation": true,
    "filesystem": {
      "allowWrite": [
        "~/.worktrees"
      ]
    },
    "network": {
      "allowUnixSockets": [
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ],
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "lfs.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "spinnerTipsEnabled": true,
  "spinnerTipsOverride": {
    "tips": [
      "Stop wasting time",
      "🐊"
    ],
    "excludeDefault": true
  }
}
