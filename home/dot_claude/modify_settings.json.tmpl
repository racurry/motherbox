#!/usr/bin/env python3
"""Merge Motherbox-owned Claude settings into Claude's live settings."""

import copy
import json
import sys

{{- $fragments := list }}
{{- range glob (joinPath .chezmoi.sourceDir ".chezmoitemplates/claude/settings/*.jsonc") }}
{{- $fragments = append $fragments (includeTemplate . $ | fromJsonc) }}
{{- end }}

# The .chezmoitemplates/claude/settings/*.jsonc files.
FRAGMENTS = json.loads(r'''{{ $fragments | toJson }}''')


def deep_merge(base, overlay):
    for key, value in overlay.items():
        if isinstance(value, dict) and isinstance(base.get(key), dict):
            deep_merge(base[key], value)
        else:
            base[key] = copy.deepcopy(value)


raw = sys.stdin.read()
current = json.loads(raw) if raw.strip() else {}

updated = copy.deepcopy(current)
for fragment in FRAGMENTS:
    deep_merge(updated, fragment)

# deep_merge replaces lists, which would drop rules added via /permissions.
# Managed rules keep their order; the user's other rules are appended.
for key in ("allow", "deny", "ask"):
    rules = updated["permissions"][key]
    rules += [r for r in current.get("permissions", {}).get(key, []) if r not in rules]

if updated == current:
    sys.stdout.write(raw)
else:
    json.dump(updated, sys.stdout, indent=2)
    sys.stdout.write("\n")
