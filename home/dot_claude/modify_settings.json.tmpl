#!/usr/bin/env python3
"""Merge Motherbox-owned Claude settings into Claude's live settings."""

import copy
import json
import sys


MANAGED_SETTINGS = json.loads(r'''{{ template "claude/settings-base.json" . }}''')


PERMISSION_LISTS = ("allow", "deny", "ask")


def deep_merge(base, overlay):
    for key, value in overlay.items():
        if isinstance(value, dict) and isinstance(base.get(key), dict):
            deep_merge(base[key], value)
        else:
            base[key] = copy.deepcopy(value)
    return base


def readd_user_permissions(settings, previous):
    """deep_merge replaces lists wholesale, which would discard rules added
    interactively via /permissions. Managed rules keep their canonical order;
    anything else the user had is appended back."""
    previous_perms = previous.get("permissions")
    if not isinstance(previous_perms, dict):
        return

    perms = settings.get("permissions")
    if not isinstance(perms, dict):
        return

    for key in PERMISSION_LISTS:
        user_rules = previous_perms.get(key)
        if not isinstance(user_rules, list):
            continue

        merged = perms.get(key)
        merged = list(merged) if isinstance(merged, list) else []
        merged.extend(rule for rule in user_rules if rule not in merged)
        perms[key] = merged


raw = sys.stdin.read()
current = json.loads(raw) if raw.strip() else {}
if not isinstance(current, dict):
    current = {}

updated = deep_merge(copy.deepcopy(current), MANAGED_SETTINGS)
readd_user_permissions(updated, current)

if raw.strip() and updated == current:
    sys.stdout.write(raw)
else:
    json.dump(updated, sys.stdout, indent=2)
    sys.stdout.write("\n")
