{{- $profile := promptStringOnce . "profile" "Profile" -}}
{{- $machine := promptStringOnce . "machine" "Machine" -}}
{{- /* The GitHub account coding agents commit as; only personal machines use one. */ -}}
{{- $agentGitName := "" -}}
{{- $agentGitEmail := "" -}}
{{- if eq $profile "personal" -}}
{{-   $agentGitName = promptStringOnce . "agent_git_name" "Agent GitHub username" -}}
{{-   $agentGitEmail = promptStringOnce . "agent_git_email" "Agent GitHub noreply email" -}}
{{- end -}}

sourceDir = {{ .chezmoi.sourceDir | quote }}

[diff]
    pager = "hunk pager"

# Refresh the shell's cached drift summary so it reflects this apply, not last night's check
[hooks.apply.post]
    command = {{ joinPath .chezmoi.workingTree "scripts/bin/motherbox-status" | quote }}
    args = ["--quiet"]

[[textconv]]
    pattern = "**/*.json"
    command = "jq"
    args = ["-S", "."]

# JSONC with comments; jq would fail on it
[[textconv]]
    pattern = "**/.config/zed/settings.json"
    command = "cat"

[data]
    profile = {{ $profile | quote }}
    machine = {{ $machine | quote }}
    agent_git_name = {{ $agentGitName | quote }}
    agent_git_email = {{ $agentGitEmail | quote }}
