#!/bin/bash
# Folder structure — thin hook: the real logic (and the declarative list) lives
# in scripts/utils/folders.sh so it can also be run by hand.
#
# Run by chezmoi during `chezmoi apply`. run_onchange re-fires whenever the
# script changes, or the machine switches profile (the firsthand folders are
# profile-gated).
#
# Script hash: {{ include (joinPath .chezmoi.workingTree "scripts/utils/folders.sh") | sha256sum }}
# Profile: {{ index . "profile" | default "personal" }}
set -euo pipefail

"$CHEZMOI_WORKING_TREE/scripts/utils/folders.sh"
