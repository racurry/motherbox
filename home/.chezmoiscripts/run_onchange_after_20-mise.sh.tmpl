#!/bin/bash
# Layer 2 — mise runtimes & global tools.
#
# Run by chezmoi during `chezmoi apply`, after 10-brew (brew installs mise).
# Thin hook: the real logic lives in scripts/apps/mise/install.sh so it can also
# be run by hand. run_onchange re-fires when the managed tool set changes, or
# when the script itself changes.
#
# mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
# Script hash: {{ include (joinPath .chezmoi.workingTree "scripts/apps/mise/install.sh") | sha256sum }}
set -euo pipefail

echo "==> Layer 2: mise install"
"$CHEZMOI_WORKING_TREE/scripts/apps/mise/install.sh"
